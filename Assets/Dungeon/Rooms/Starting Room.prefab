  grumbles:
  - {fileID: 3734932179283865293, guid: 774c574b931bd0f498c71de31c9705ac, type: 3}
  - {fileID: 3734932179283865293, guid: aac22f1751fe83043aa49f89e68554b8, type: 3}
  - {fileID: 3734932179283865293, guid: f7581f1a42e5cdb49ab9f0ca78d91018, type: 3}
  - {fileID: 3734932179283865293, guid: 06d26cead4e330441a7759b69c651fd2, type: 3}
  interactAction:
    m_Name: Interact
    m_Type: 0
    m_ExpectedControlType: 
    m_Id: 30574fdd-4e45-4cb5-996e-89e4b88ef9de
    m_Processors: 
    m_Interactions: 
    m_SingletonActionBindings:
    - m_Name: 
      m_Id: bb88299a-eff3-4255-b280-019d47318c6e
      m_Path: <Keyboard>/e
      m_Interactions: 
      m_Processors: 
      m_Groups: 
      m_Action: Interact
      m_Flags: 0
    m_Flags: 0
  privateDialoguesList:
  - Sir! Welcome to the forest. With the clock tower now activated...
  - time is of the essence so I'll keep this brief.
  - You can move with WASD and dash with the [shift] key. Right now you
  - only have a gun but that is shot with left click. The Gnomes will try to...
  - stop you but if you can find the exits and defeat the clock tower you might...
  - just be able to save time. If you encounter my brother along the way...
  - ' he''ll sell you some sick upgrades at the cost of just a little time.'
  - Good luck and stay sharp!
  exhaustedDialogueText: Good luck!
